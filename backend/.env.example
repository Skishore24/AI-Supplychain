# ==========================================
# AI-Supplychain Environment Configuration
# Copy to .env and configure for your environment
# ==========================================

# Database URL (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@localhost:5432/supply_chain_db

# Security & JWT
JWT_SECRET=your_super_secret_enterprise_jwt_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Ollama Local AI Runtime
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_SMALL_MODEL=llama3.2:3b
OLLAMA_REASONING_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Document & RAG Pipeline
MAX_DOCUMENT_SIZE=20971520
RAG_TOP_K=20
RAG_RERANK_K=5
AI_TIMEOUT_SECONDS=60

# Server Configuration
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=INFO
ENVIRONMENT=development
